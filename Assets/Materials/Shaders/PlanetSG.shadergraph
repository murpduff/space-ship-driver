{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1c7c4bef830b4412baa70c9c9c77da75",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SampleCubeArray (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -545.5000610351563,
            "y": 89.00003814697266,
            "width": 257.0,
            "height": 325.9999694824219
        }
    },
    "m_Slots": [
        {
            "m_Id": "09425c251ea6413aa30a35b4e3bb5e44"
        },
        {
            "m_Id": "d23afe3a5da6411383f5d262dd678c35"
        },
        {
            "m_Id": "644eb654b50b40e6b86f1cc9ce1701ca"
        },
        {
            "m_Id": "2fbd885342744e7380ccf6b625721480"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SampleCubeArray",
    "m_FunctionSource": "011de4ea3955a4dc6ae3f6b7bbb9231a",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 absDir = abs(ViewDir);\nfloat maxAxis = max(absDir.x, max(absDir.y, absDir.z));\nfloat2 uv = 0;\nfloat index = 0;\n\nif (maxAxis == absDir.x) {\n    index = ViewDir.x > 0 ? 0 : 1; // +X, -X\n    uv = ViewDir.x > 0 ? float2(-ViewDir.z, -ViewDir.y) : float2(ViewDir.z, -ViewDir.y);\n} \nelse if (maxAxis == absDir.y) {\n    index = ViewDir.y > 0 ? 2 : 3; // +Y, -Y\n    uv = ViewDir.y > 0 ? float2(ViewDir.x, ViewDir.z) : float2(ViewDir.x, -ViewDir.z);\n} \nelse {\n    index = ViewDir.z > 0 ? 4 : 5; // +Z, -Z\n    uv = ViewDir.z > 0 ? float2(ViewDir.x, -ViewDir.y) : float2(-ViewDir.x, -ViewDir.y);\n}\n\nuv = uv / maxAxis * 0.5 + 0.5;\nOut = TexArray.Sample(Sampler, float3(uv, index));"
}

